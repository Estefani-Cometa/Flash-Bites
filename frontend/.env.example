# Frontend Environment Variables Example
# Copy this to .env and fill in with your actual values

# API Configuration
VITE_API_URL=http://localhost:8000/api/v1

# Para producción, reemplazar durante el build por:
# VITE_API_URL=https://flash-bites-production.up.railway.app/api/v1

# Optional: Add other Vite variables as needed
# VITE_APP_TITLE=Flash-Bites
# VITE_DEBUG=false
